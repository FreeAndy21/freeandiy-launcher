+    let t = fa_tag.as_deref().unwrap_or(t);
     // Debian/RPM spell pre-releases with `~` and append a package revision after `-`.
     let debianish = t.contains('~');
     let t = if debianish { t.split_once('-').map_or(t, |(v, _)| v).replace('~', "-") } else { t.to_string() };
