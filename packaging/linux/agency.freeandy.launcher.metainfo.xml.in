<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>agency.freeandy.launcher</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>FreeANDIY Launcher</name>
  <summary>Install, update and launch the FreeANDIY apps</summary>
  <developer id="agency.freeandy">
    <name>Free Andy Agency</name>
  </developer>
  <description>
    <p>
      FreeANDIY Launcher lists every app in the FreeANDIY apps (FreeANDIY Photo, FreeANDIY Light, FreeANDIY Film,
      FreeANDIY Layout, FreeANDIY Vector, FreeANDIY PDF, FreeANDIY Effects, FreeANDIY Write, FreeANDIY Slides, FreeANDIY Sheets, CADCraft,
      FreeANDIY Sound and FigCraft), installs the right build for your computer, and keeps them up to date.
    </p>
    <ul>
      <li>One place to find, install and open every Craft app</li>
      <li>Checks GitHub releases for updates and installs them for you</li>
      <li>Lives in the system tray and tells you when updates are ready</li>
    </ul>
  </description>
  <launchable type="desktop-id">agency.freeandy.launcher.desktop</launchable>
  <icon type="stock">agency.freeandy.launcher</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://freeandiy-web.vercel.appapps</url>
  <url type="bugtracker">https://github.com/FreeAndy21/freeandiy-launcher/issues</url>
  <url type="help">https://github.com/FreeAndy21/freeandiy-launcher</url>
  <url type="contact">https://github.com/FreeAndy21/freeandiy/issues</url>
  <categories>
    <category>Utility</category>
    <category>PackageManager</category>
  </categories>
  <keywords>
    <keyword>launcher</keyword>
    <keyword>installer</keyword>
    <keyword>updater</keyword>
    <keyword>freeandiy</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#d9dce3</color>
    <color type="primary" scheme_preference="dark">#26282e</color>
  </branding>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
  </supports>
  <provides>
    <binary>freeandiy-launcher</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
